{
  "schema_version": "schednav.host-bridge-config/v1",
  "artifact_root": "artifacts",
  "task_subdir": "agentteams-predictive-bridge/tasks",
  "max_workers": 1,
  "operation_allowlist": [
    "forecast_demand",
    "simulate_predictive_policy",
    "compare_policies",
    "audit_slo",
    "rank_policies"
  ],
  "run_configs": {
    "native-local": "configs/runs/native-local.json",
    "tenant-predictive-local": "configs/runs/tenant-predictive-local.json"
  },
  "run_sets": {
    "native-local": [
      "native-local"
    ],
    "tenant-predictive-local": [
      "tenant-predictive-local"
    ]
  },
  "action_space": "configs/action_spaces/native-multiwindow-v3.json",
  "controllers": {
    "predictive-spot-v1": "configs/controllers/predictive-spot-v1.json",
    "tenant-predictive-spot-v1": "configs/controllers/tenant-predictive-spot-v1.json"
  },
  "actions": {
    "native-fifo": "configs/policies/native-fifo.json",
    "native-preemptive-0000": "configs/policies/native-preemptive-0000.json",
    "native-preemptive-1800": "configs/policies/native-preemptive-1800.json",
    "native-preemptive-3600": "configs/policies/native-preemptive-3600.json",
    "native-preemptive-budget09-d0000": "configs/policies/native-preemptive-budget09-d0000.json",
    "native-preemptive-budget09-d0900": "configs/policies/native-preemptive-budget09-d0900.json",
    "native-preemptive-budget09-d1800": "configs/policies/native-preemptive-budget09-d1800.json",
    "native-preemptive-g3600-b09-d0000": "configs/policies/native-preemptive-g3600-b09-d0000.json",
    "native-preemptive-g3600-b09-d0900": "configs/policies/native-preemptive-g3600-b09-d0900.json",
    "native-preemptive-g3600-b09-loss-aware": "configs/policies/native-preemptive-g3600-b09-loss-aware.json"
  },
  "slo_specs": {
    "schednav-demo-slo-v1": "configs/slos/schednav-demo-slo-v1.json"
  },
  "baseline_metrics": {}
}
