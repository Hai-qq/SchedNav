{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schednav.local/schemas/accepted-decision.schema.json",
  "title": "SchedNav Accepted Decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "status",
    "outcome",
    "selected_action_id",
    "selected_policy",
    "ranking",
    "final_approval",
    "selection_basis",
    "new_simulation_performed"
  ],
  "properties": {
    "schema_version": {"const": "schednav.accepted-decision/v1"},
    "project_id": {"type": "string", "minLength": 1},
    "status": {"const": "completed"},
    "outcome": {"const": "accepted"},
    "selected_action_id": {"const": "repository-default-gfs"},
    "selected_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scheduler", "guarantee_rate", "policy_fingerprint"],
      "properties": {
        "scheduler": {"const": "spot_scheduler"},
        "guarantee_rate": {"const": 0.9},
        "policy_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "ranking": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selection_status", "ranking_fingerprint", "artifact_ref", "artifact_sha256"],
      "properties": {
        "selection_status": {"const": "tie_requires_human_approval"},
        "ranking_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "artifact_ref": {"type": "string", "minLength": 1},
        "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "final_approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "origin_server_ts", "decision_maker", "approved_at", "decision"],
      "properties": {
        "event_id": {"type": "string", "minLength": 2},
        "origin_server_ts": {"type": "integer", "minimum": 0},
        "decision_maker": {"type": "string", "minLength": 1},
        "approved_at": {"type": "string", "format": "date-time"},
        "decision": {"const": "accept repository-default-gfs"}
      }
    },
    "selection_basis": {"type": "string", "minLength": 1},
    "new_simulation_performed": {"const": false}
  }
}
