{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hai-qq/SchedNav/schemas/rolling-ablation-evidence.schema.json",
  "title": "SchedNav compact rolling-ablation evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "study_id",
    "design_fingerprint",
    "data_fingerprint",
    "implementation_fingerprint",
    "prompt_fingerprint",
    "window_count",
    "holdout_window_ids",
    "record_count",
    "agentteams",
    "arms",
    "multi_agent_pairwise_hierarchy",
    "multi_agent_superiority_gate",
    "multi_agent_vs_ordinary_gate",
    "definition",
    "evidence_fingerprint"
  ],
  "properties": {
    "schema_version": {"const": "schednav.rolling-ablation-evidence/v1"},
    "study_id": {"type": "string", "minLength": 1},
    "design_fingerprint": {"$ref": "#/$defs/fingerprint"},
    "data_fingerprint": {
      "oneOf": [{"$ref": "#/$defs/fingerprint"}, {"type": "null"}]
    },
    "implementation_fingerprint": {
      "oneOf": [{"$ref": "#/$defs/fingerprint"}, {"type": "null"}]
    },
    "prompt_fingerprint": {"$ref": "#/$defs/fingerprint"},
    "window_count": {"type": "integer", "minimum": 1},
    "holdout_window_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "record_count": {"type": "integer", "minimum": 0},
    "agentteams": {"type": ["object", "null"]},
    "arms": {"type": "object"},
    "multi_agent_pairwise_hierarchy": {
      "type": "object",
      "additionalProperties": {"enum": ["better", "worse", "tie"]}
    },
    "multi_agent_superiority_gate": {
      "enum": ["incomplete", "supported", "not_established"]
    },
    "multi_agent_vs_ordinary_gate": {
      "enum": ["incomplete", "supported", "not_established"]
    },
    "analyst_causal_value_gate": {
      "enum": ["incomplete", "supported", "not_established"]
    },
    "analyst_causal_pairwise_hierarchy": {
      "enum": ["incomplete", "better", "worse", "tie"]
    },
    "analyst_causal_matched_resources": {
      "type": ["object", "null"]
    },
    "definition": {"type": "string", "minLength": 1},
    "evidence_fingerprint": {"$ref": "#/$defs/fingerprint"}
  },
  "$defs": {
    "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
