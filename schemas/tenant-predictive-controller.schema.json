{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hai-qq/SchedNav/schemas/tenant-predictive-controller.schema.json",
  "title": "SchedNav tenant-aware predictive Spot controller",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "controller_id",
    "model",
    "demand_sample_interval_seconds",
    "quota_update_interval_seconds",
    "aggregation_interval_seconds",
    "lookback_hours",
    "forecast_horizon_hours",
    "retrain_interval_seconds",
    "validation_hours",
    "training_stride_seconds",
    "guarantee_probability",
    "guarantee_horizons_hours",
    "business_calendar",
    "moving_average_window",
    "embedding_dimension",
    "attention_hidden_dimension",
    "train_epochs",
    "batch_size",
    "learning_rate",
    "early_stopping_patience",
    "random_seed",
    "nonzero_targets_only",
    "initial_eta",
    "minimum_eta",
    "maximum_eta",
    "feedback_window_seconds",
    "queue_wait_threshold_seconds",
    "high_eviction_multiple",
    "low_eviction_multiple",
    "runtime_inventory_cap"
  ],
  "properties": {
    "schema_version": {"const": "schednav.tenant-predictive-controller/v1"},
    "controller_id": {"type": "string", "minLength": 1},
    "model": {"const": "tenant-linear-gaussian-v1"},
    "demand_sample_interval_seconds": {"type": "integer", "minimum": 1},
    "quota_update_interval_seconds": {"type": "integer", "minimum": 1},
    "aggregation_interval_seconds": {"const": 3600},
    "lookback_hours": {"type": "integer", "minimum": 1},
    "forecast_horizon_hours": {"type": "integer", "minimum": 1},
    "retrain_interval_seconds": {"type": "integer", "minimum": 1},
    "validation_hours": {"type": "integer", "minimum": 1},
    "training_stride_seconds": {"type": "integer", "minimum": 1},
    "guarantee_probability": {"type": "number", "exclusiveMinimum": 0.5, "exclusiveMaximum": 1},
    "guarantee_horizons_hours": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 1}
    },
    "business_calendar": {"enum": ["china", "weekday"]},
    "moving_average_window": {"type": "integer", "minimum": 1},
    "embedding_dimension": {"type": "integer", "minimum": 1},
    "attention_hidden_dimension": {"type": "integer", "minimum": 1},
    "train_epochs": {"type": "integer", "minimum": 1},
    "batch_size": {"type": "integer", "minimum": 1},
    "learning_rate": {"type": "number", "exclusiveMinimum": 0},
    "early_stopping_patience": {"type": "integer", "minimum": 1},
    "random_seed": {"type": "integer", "minimum": 0},
    "nonzero_targets_only": {"type": "boolean"},
    "initial_eta": {"type": "number", "exclusiveMinimum": 0},
    "minimum_eta": {"type": "number", "exclusiveMinimum": 0},
    "maximum_eta": {"type": "number", "exclusiveMinimum": 0},
    "feedback_window_seconds": {"type": "integer", "minimum": 1},
    "queue_wait_threshold_seconds": {"type": "integer", "minimum": 1},
    "high_eviction_multiple": {"type": "number", "minimum": 1},
    "low_eviction_multiple": {"type": "number", "minimum": 0, "maximum": 1},
    "runtime_inventory_cap": {"type": "boolean"}
  }
}
