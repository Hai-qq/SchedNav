{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hai-qq/SchedNav/schemas/rolling-ablation-preparation.schema.json",
  "title": "SchedNav rolling-ablation trace preparation receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "design_fingerprint", "data_fingerprint", "source_hashes", "windows", "preparation_fingerprint"],
  "properties": {
    "schema_version": {"const": "schednav.rolling-ablation-preparation/v1"},
    "design_fingerprint": {"$ref": "#/$defs/fingerprint"},
    "data_fingerprint": {"$ref": "#/$defs/fingerprint"},
    "source_hashes": {"type": "object"},
    "windows": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "preparation_fingerprint": {"$ref": "#/$defs/fingerprint"}
  },
  "$defs": {
    "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
