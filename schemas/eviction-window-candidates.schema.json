{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hai-qq/SchedNav/schemas/eviction-window-candidates.schema.json",
  "title": "SchedNav eviction window candidates",
  "type": "object",
  "required": ["schema_version", "trace_origin", "date_range", "algorithm", "source_evidence", "definitions", "candidates", "scan_fingerprint"],
  "properties": {
    "schema_version": {"const": "schednav.eviction-window-candidates/v1"},
    "trace_origin": {"const": "2024-03-01 00:00:00"},
    "date_range": {"type": "object"},
    "algorithm": {"const": "early-spot-late-hp-pressure/v1"},
    "source_evidence": {"type": "object"},
    "definitions": {"type": "object"},
    "candidates": {"type": "array", "items": {"type": "object"}},
    "scan_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
