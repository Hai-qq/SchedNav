{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hai-qq/SchedNav/schemas/adaptive-evidence.schema.json",
  "title": "SchedNav public adaptive holdout evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "study", "calibration_static_selection", "best_static_action_id", "controllers", "evaluation_windows", "limitations", "source_evidence", "receipt_fingerprint"],
  "properties": {
    "schema_version": {"const": "schednav.adaptive-evidence/v1"},
    "study": {"type": "object"},
    "calibration_static_selection": {"type": "object"},
    "best_static_action_id": {"type": "string", "minLength": 1},
    "controllers": {
      "type": "object",
      "required": ["fifo", "best_static", "workload_rule", "agentteams", "catalog_oracle"]
    },
    "evaluation_windows": {"type": "array", "minItems": 1},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "source_evidence": {"type": "object"},
    "receipt_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
