{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hai-qq/SchedNav/schemas/run-manifest.schema.json",
  "title": "SchedNav GFS run manifest",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "status",
    "run_spec_fingerprint",
    "policy_fingerprint",
    "gfs_commit",
    "gfs_patch_sha256",
    "trace_commit",
    "trace_id",
    "command",
    "result_files"
  ],
  "properties": {
    "schema_version": {"const": "schednav.run-manifest/v1"},
    "run_id": {"type": "string"},
    "status": {"enum": ["running", "succeeded", "failed"]},
    "run_spec_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "policy_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gfs_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "gfs_patch_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "trace_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "trace_id": {"type": "string"},
    "command": {"type": "array", "items": {"type": "string"}},
    "result_files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256", "size_bytes"],
        "properties": {
          "path": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "size_bytes": {"type": "integer", "minimum": 0}
        }
      }
    }
  }
}
