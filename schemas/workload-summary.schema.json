{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hai-qq/SchedNav/schemas/workload-summary.schema.json",
  "title": "SchedNav workload summary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "trace_id",
    "trace_fingerprint",
    "time_origin",
    "source",
    "capacity_gpus",
    "window_seconds",
    "sample_interval_seconds",
    "population",
    "regime_signals",
    "definitions",
    "workload_fingerprint"
  ],
  "properties": {
    "schema_version": {"const": "schednav.workload-summary/v2"},
    "trace_id": {"type": "string", "minLength": 1},
    "trace_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "time_origin": {"type": "string", "minLength": 1},
    "source": {"type": "object"},
    "capacity_gpus": {"type": "integer", "minimum": 1},
    "window_seconds": {"type": "object", "required": ["start", "end"]},
    "sample_interval_seconds": {"type": "integer", "minimum": 1},
    "population": {"type": "object", "required": ["HP", "Spot"]},
    "regime_signals": {"type": "object"},
    "definitions": {"type": "object"},
    "workload_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
