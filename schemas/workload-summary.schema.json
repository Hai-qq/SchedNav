{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hai-qq/SchedNav/schemas/workload-summary.schema.json",
  "title": "SchedNav workload summary",
  "type": "object",
  "required": ["schema_version", "trace_origin", "gpu_model", "capacity_gpus", "window", "sample_interval_seconds", "population", "regime_signals", "source_evidence", "definitions", "workload_fingerprint"],
  "properties": {
    "schema_version": {"const": "schednav.workload-summary/v1"},
    "trace_origin": {"const": "2024-03-01 00:00:00"},
    "gpu_model": {"type": "string"},
    "capacity_gpus": {"type": "number", "exclusiveMinimum": 0},
    "window": {"type": "object"},
    "sample_interval_seconds": {"type": "integer", "minimum": 1},
    "population": {"type": "object"},
    "regime_signals": {"type": "object"},
    "source_evidence": {"type": "object"},
    "definitions": {"type": "object"},
    "workload_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
