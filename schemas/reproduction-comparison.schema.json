{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hai-qq/SchedNav/schemas/reproduction-comparison.schema.json",
  "title": "SchedNav reproduction comparison",
  "type": "object",
  "required": ["schema_version", "comparable", "deterministic_match", "first_run", "second_run", "compared_files", "differences"],
  "properties": {
    "schema_version": {"const": "schednav.reproduction-comparison/v1"},
    "comparable": {"type": "boolean"},
    "deterministic_match": {"type": "boolean"},
    "first_run": {"type": ["string", "null"]},
    "second_run": {"type": ["string", "null"]},
    "compared_files": {"type": "array", "items": {"type": "string"}},
    "differences": {"type": "object"}
  }
}
