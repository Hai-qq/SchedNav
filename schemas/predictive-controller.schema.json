{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hai-qq/SchedNav/schemas/predictive-controller.schema.json",
  "title": "SchedNav predictive Spot controller",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "controller_id",
    "model",
    "observation_interval_seconds",
    "aggregation_interval_seconds",
    "lookback_hours",
    "forecast_horizon_hours",
    "retrain_interval_seconds",
    "guarantee_probability",
    "guarantee_horizons_hours",
    "minimum_history_hours",
    "minimum_sigma_gpus",
    "initial_eta",
    "minimum_eta",
    "maximum_eta",
    "feedback_window_seconds",
    "starvation_increase_after_seconds",
    "high_eviction_ratio",
    "low_eviction_ratio",
    "eta_increase_step"
  ],
  "properties": {
    "schema_version": {"const": "schednav.predictive-controller/v1"},
    "controller_id": {"type": "string", "minLength": 1},
    "model": {"const": "seasonal-gaussian-v1"},
    "observation_interval_seconds": {"type": "integer", "minimum": 1},
    "aggregation_interval_seconds": {"const": 3600},
    "lookback_hours": {"type": "integer", "minimum": 1},
    "forecast_horizon_hours": {"type": "integer", "minimum": 1},
    "retrain_interval_seconds": {"type": "integer", "minimum": 1},
    "guarantee_probability": {"type": "number", "exclusiveMinimum": 0.5, "exclusiveMaximum": 1},
    "guarantee_horizons_hours": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 1}
    },
    "minimum_history_hours": {"type": "integer", "minimum": 1},
    "minimum_sigma_gpus": {"type": "number", "minimum": 0},
    "initial_eta": {"type": "number", "exclusiveMinimum": 0},
    "minimum_eta": {"type": "number", "exclusiveMinimum": 0},
    "maximum_eta": {"type": "number", "exclusiveMinimum": 0},
    "feedback_window_seconds": {"type": "integer", "minimum": 1},
    "starvation_increase_after_seconds": {"type": "integer", "minimum": 1},
    "high_eviction_ratio": {"type": "number", "minimum": 1},
    "low_eviction_ratio": {"type": "number", "minimum": 0, "maximum": 1},
    "eta_increase_step": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
  }
}
