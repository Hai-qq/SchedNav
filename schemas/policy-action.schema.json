{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hai-qq/SchedNav/schemas/policy-action.schema.json",
  "title": "SchedNav high-level policy action",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "action_id", "scheduler", "guarantee_hours", "guarantee_rate", "ckpt_interval_seconds"],
  "properties": {
    "schema_version": {"const": "schednav.policy-action/v1"},
    "action_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "scheduler": {"enum": ["fifo_spot", "spot_scheduler"]},
    "guarantee_hours": {"type": "array", "items": {"type": "integer", "minimum": 1}},
    "guarantee_rate": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
    "ckpt_interval_seconds": {"type": "integer", "minimum": 1}
  }
}
