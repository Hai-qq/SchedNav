{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hai-qq/SchedNav/schemas/reproduction-run.schema.json",
  "title": "SchedNav reproduction run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experiment_name",
    "gfs_dir",
    "gfs_commit",
    "gfs_patch",
    "source_trace_dir",
    "trace_commit",
    "python_executable",
    "artifacts_dir",
    "window",
    "policy"
  ],
  "properties": {
    "schema_version": {"const": "schednav.reproduction-run/v1"},
    "experiment_name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "gfs_dir": {"type": "string", "minLength": 1},
    "gfs_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "gfs_patch": {"type": "string", "minLength": 1},
    "source_trace_dir": {"type": "string", "minLength": 1},
    "trace_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "python_executable": {"type": "string", "minLength": 1},
    "artifacts_dir": {"type": "string", "minLength": 1},
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["submit_time_origin", "trace_end", "evaluation_start", "evaluation_end", "gpu_models", "drain_mode"],
      "properties": {
        "submit_time_origin": {"const": "2024-03-01 00:00:00"},
        "trace_end": {"type": "string"},
        "evaluation_start": {"type": "string"},
        "evaluation_end": {"type": "string"},
        "gpu_models": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "drain_mode": {"const": "until_all_jobs_end"}
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scheduler", "guarantee_hours", "guarantee_rate", "ckpt_interval_seconds", "seed", "device", "deterministic"],
      "properties": {
        "scheduler": {"enum": ["fifo_spot", "spot_scheduler"]},
        "guarantee_hours": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1}},
        "guarantee_rate": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "ckpt_interval_seconds": {"type": "integer", "minimum": 1},
        "seq_len_hours": {"type": "integer", "minimum": 1},
        "pred_len_hours": {"type": "integer", "minimum": 1},
        "estimator_validation_days": {"type": "integer", "minimum": 0},
        "recorder_initial_skip_hours": {"type": "integer", "minimum": 0},
        "train_epochs": {"type": "integer", "minimum": 1},
        "num_workers": {"type": "integer", "minimum": 0},
        "seed": {"type": "integer"},
        "device": {"enum": ["cpu", "cuda"]},
        "deterministic": {"type": "boolean"}
      }
    }
  }
}
