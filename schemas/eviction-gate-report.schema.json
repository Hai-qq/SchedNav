{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hai-qq/SchedNav/schemas/eviction-gate-report.schema.json",
  "title": "SchedNav eviction gate report",
  "type": "object",
  "required": ["schema_version", "metrics_fingerprint", "criteria", "gate_passed", "observed", "definition", "gate_fingerprint"],
  "properties": {
    "schema_version": {"const": "schednav.eviction-gate-report/v1"},
    "metrics_fingerprint": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "criteria": {"type": "object"},
    "gate_passed": {"type": "boolean"},
    "observed": {"type": "object"},
    "definition": {"type": "string"},
    "gate_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
