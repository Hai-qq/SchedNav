{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schednav.local/schemas/trace-vendor-manifest.schema.json",
  "title": "SchedNav Local Trace Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "repository", "upstream_commit", "license", "distribution", "files"],
  "properties": {
    "schema_version": {"const": "schednav.trace-vendor-manifest/v1"},
    "repository": {"type": "string", "format": "uri"},
    "upstream_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "license": {"const": "not found in pinned repository tree"},
    "distribution": {"const": "local-only; exclude from public repository and release artifacts"},
    "files": {
      "type": "object",
      "minProperties": 2,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sha256", "size_bytes"],
        "properties": {
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "size_bytes": {"type": "integer", "minimum": 0}
        }
      }
    }
  }
}
