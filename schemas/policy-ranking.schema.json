{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hai-qq/SchedNav/schemas/policy-ranking.schema.json",
  "title": "SchedNav deterministic policy ranking",
  "type": "object",
  "required": ["schema_version", "slo_name", "slo_fingerprint", "selection_status", "candidates", "stages", "selected_policy_fingerprints", "definition", "ranking_fingerprint"],
  "properties": {
    "schema_version": {"const": "schednav.policy-ranking/v1"},
    "slo_name": {"type": "string"},
    "slo_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "selection_status": {"enum": ["selected", "no_eligible_policy", "tie_requires_human_approval"]},
    "candidates": {"type": "array", "minItems": 3, "maxItems": 5, "items": {"type": "object"}},
    "stages": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "selected_policy_fingerprints": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "definition": {"type": "string"},
    "ranking_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
