{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hai-qq/SchedNav/schemas/trace-manifest.schema.json",
  "title": "SchedNav prepared trace manifest",
  "type": "object",
  "required": ["schema_version", "trace_id", "created_at", "identity", "counts", "prepared_files"],
  "properties": {
    "schema_version": {"const": "schednav.trace-manifest/v1"},
    "trace_id": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "identity": {"type": "object"},
    "counts": {
      "type": "object",
      "required": ["nodes", "hp_jobs", "spot_jobs"],
      "properties": {
        "nodes": {"type": "integer", "minimum": 1},
        "hp_jobs": {"type": "integer", "minimum": 1},
        "spot_jobs": {"type": "integer", "minimum": 1}
      }
    },
    "prepared_files": {"type": "object"}
  }
}
