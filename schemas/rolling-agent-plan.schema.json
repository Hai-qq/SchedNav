{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hai-qq/SchedNav/schemas/rolling-agent-plan.schema.json",
  "title": "SchedNav fingerprint-bound rolling Agent plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "controller_id", "mode", "model_id", "source", "decisions", "definition", "plan_fingerprint"],
  "properties": {
    "schema_version": {"const": "schednav.rolling-agent-plan/v1"},
    "controller_id": {"type": "string", "minLength": 1},
    "mode": {"enum": ["single_agent", "multi_agent", "multi_agent_masked"]},
    "model_id": {"const": "deepseek-v4-flash"},
    "required_candidate_action_id": {"type": "string", "minLength": 1},
    "source": {"type": "object"},
    "decisions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/decision"}},
    "definition": {"type": "string"},
    "plan_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observation_fingerprint", "candidate_action_ids", "reason_code", "agent_stage_receipts", "llm_call_count", "prompt_tokens", "completion_tokens"],
      "properties": {
        "observation_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "candidate_action_ids": {"type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": {"type": "string"}},
        "reason_code": {"type": "string", "minLength": 1, "maxLength": 256},
        "agent_stage_receipts": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "llm_call_count": {"type": "integer", "minimum": 0},
        "prompt_tokens": {"type": "integer", "minimum": 0},
        "completion_tokens": {"type": "integer", "minimum": 0}
      }
    }
  }
}
