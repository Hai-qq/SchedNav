{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hai-qq/SchedNav/schemas/rolling-agent-plan-set.schema.json",
  "title": "SchedNav collected AgentTeams rolling plan set",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "framework", "model_id", "design_fingerprint", "stage_receipt_verification", "plans", "manifest_fingerprint"],
  "properties": {
    "schema_version": {"const": "schednav.rolling-agent-plan-set/v1"},
    "project_id": {"type": "string", "minLength": 1},
    "framework": {"const": "AgentTeams"},
    "model_id": {"const": "deepseek-v4-flash"},
    "design_fingerprint": {"$ref": "#/$defs/fingerprint"},
    "stage_receipt_verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "receipt_count", "context_isolation"],
      "properties": {
        "status": {"const": "verified"},
        "receipt_count": {"type": "integer", "minimum": 1},
        "context_isolation": {"const": "verified"}
      }
    },
    "plans": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["window_id", "mode", "controller_id", "plan_fingerprint", "decision_count", "source_task_directory", "artifact"],
        "properties": {
          "window_id": {"type": "string", "minLength": 1},
          "mode": {"enum": ["single_agent", "multi_agent", "multi_agent_masked"]},
          "controller_id": {"type": "string", "minLength": 1},
          "plan_fingerprint": {"$ref": "#/$defs/fingerprint"},
          "decision_count": {"type": "integer", "minimum": 1},
          "source_task_directory": {"type": "string", "minLength": 1},
          "artifact": {"type": "string", "minLength": 1}
        }
      }
    },
    "source_anomalies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_meta_trailing_literal_newline", "handling"],
      "properties": {
        "task_meta_trailing_literal_newline": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "handling": {"const": "read-only parse normalization; source bytes unmodified"}
      }
    },
    "manifest_fingerprint": {"$ref": "#/$defs/fingerprint"}
  },
  "$defs": {
    "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
