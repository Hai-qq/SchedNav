{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hai-qq/SchedNav/schemas/rolling-ablation-data.schema.json",
  "title": "SchedNav rolling-ablation data preparation contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "study_id", "design_fingerprint", "dataset", "execution_contract", "workload_history_contract", "windows", "data_fingerprint"],
  "properties": {
    "schema_version": {"const": "schednav.rolling-ablation-data/v1"},
    "study_id": {"type": "string", "minLength": 1},
    "design_fingerprint": {"$ref": "#/$defs/fingerprint"},
    "dataset": {"type": "object"},
    "execution_contract": {"type": "object"},
    "workload_history_contract": {"type": "object"},
    "windows": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "data_fingerprint": {"$ref": "#/$defs/fingerprint"}
  },
  "$defs": {
    "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
